<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    tools:context=".ui.ConfigurationFragment">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/colorBackground"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:elevation="0dp"
        app:liftOnScroll="false">

        <FrameLayout
            android:id="@+id/toolbar_container"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:theme="@style/ThemeOverlay.SagerNet.Toolbar.Compact"
                android:touchscreenBlocksFocus="false"
                app:elevation="0dp"
                app:contentInsetStart="0dp"
                app:contentInsetStartWithNavigation="0dp"
                app:contentInsetEnd="0dp"
                app:titleMargin="0dp"
                app:titleMarginStart="0dp"
                app:titleMarginEnd="0dp"
                app:navigationIconTint="?android:attr/textColorPrimary"
                app:popupTheme="?attr/actionBarPopupTheme" />

            <TextView
                android:id="@+id/toolbar_title_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="46dp"
                android:elevation="12dp"
                android:text="@string/app_name"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="16sp"
                android:letterSpacing="-0.01"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:ellipsize="none" />

        </FrameLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <include
        android:id="@+id/home_header"
        layout="@layout/layout_home_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/group_tab_container"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:background="@android:color/transparent"
        android:visibility="gone">

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/group_tab"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            app:tabContentStart="0dp"
            android:background="@android:color/transparent"
            android:elevation="0dp"
            app:tabIndicator="@drawable/bg_tab_capsule"
            app:tabIndicatorGravity="center"
            app:tabIndicatorHeight="34dp"
            app:tabIndicatorFullWidth="true"
            app:tabIndicatorAnimationMode="linear"
            app:tabMode="scrollable"
            app:tabPaddingStart="16dp"
            app:tabPaddingEnd="16dp"
            app:tabPaddingTop="0dp"
            app:tabPaddingBottom="0dp"
            app:tabRippleColor="@android:color/transparent"
            app:tabTextAppearance="@style/Widget.SagerNet.TabLayout.TextAppearance.Capsule"
            app:tabSelectedTextAppearance="@style/Widget.SagerNet.TabLayout.TextAppearance.Capsule.Selected"
            app:tabUnboundedRipple="false" />

    </FrameLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/group_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>