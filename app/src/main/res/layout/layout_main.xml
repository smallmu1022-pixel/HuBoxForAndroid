<?xml version="1.0" encoding="utf-8"?>
<!-- HuBox v1.1.0: drawer removed. Root is a plain CoordinatorLayout with
     fragment holder and a text-only
     glass bottom navigation (Home / Configuration / Tools / Settings). -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/fragment_holder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="56dp" />


    <View
        android:id="@+id/menu_scrim_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:visibility="gone"
        android:alpha="0"
        android:elevation="20dp" />

    <!-- v1.1.0: text-only bottom navigation, no icons (avoids overlap) -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_nav_glass"
        android:elevation="8dp"
        app:itemIconSize="0dp"
        app:itemTextAppearanceActive="@style/TextAppearance.HuBox.BottomNav.Active"
        app:itemTextAppearanceInactive="@style/TextAppearance.HuBox.BottomNav"
        app:itemTextColor="@color/bottom_nav_tint"
        app:itemBackground="@drawable/bg_bottom_nav_item"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_navigation" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
