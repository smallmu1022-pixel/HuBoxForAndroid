<?xml version="1.0" encoding="utf-8"?>
<!-- HuBox v1.1.0 widget capsule button (dark): deep navy glass -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="135"
                android:startColor="#590D2247"
                android:endColor="#4010305E" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <stroke
                android:width="1dp"
                android:color="#4D5A85" />
        </shape>
    </item>
</layer-list>
