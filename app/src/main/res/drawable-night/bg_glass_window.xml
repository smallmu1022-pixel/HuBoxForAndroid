<?xml version="1.0" encoding="utf-8"?>
<!-- HuBox v1.1.0 glass window background (dark, ocean default).
     Main pages override this at runtime with the active Palette gradient. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="#10305E"
        android:centerColor="#0D2247"
        android:startColor="#0A1A36"
        android:type="linear" />
</shape>
