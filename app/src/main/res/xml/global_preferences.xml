<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <Preference
        app:icon="@drawable/ic_baseline_tune_24"
        app:key="homeCustomize"
        app:summary="@string/home_customize_summary"
        app:title="@string/home_customize_title"
        app:widgetLayout="@layout/preference_widget_chevron" />

    <Preference
        app:fragment="io.nekohasekai.sagernet.ui.AppearanceSettingsFragment"
        app:icon="@drawable/ic_line_eye_24"
        app:key="screenUI"
        app:summary="@string/settings_ui_summary"
        app:title="@string/ui_settings"
        app:widgetLayout="@layout/preference_widget_chevron" />

    <Preference
        app:fragment="io.nekohasekai.sagernet.ui.settings.VpnSettingsFragment"
        app:icon="@drawable/solar_lock_keyhole_minimalistic_linear"
        app:key="screenVPN"
        app:summary="@string/settings_vpn_summary"
        app:title="@string/vpn_settings"
        app:widgetLayout="@layout/preference_widget_chevron" />

    <Preference
        app:fragment="io.nekohasekai.sagernet.ui.settings.ModeSettingsFragment"
        app:icon="@drawable/solar_slider_minimalistic_horizontal_linear"
        app:key="screenMode"
        app:summary="@string/settings_mode_summary"
        app:title="@string/mode_and_inbound_settings"
        app:widgetLayout="@layout/preference_widget_chevron" />

    <Preference
        app:fragment="io.nekohasekai.sagernet.ui.settings.CoreSettingsFragment"
        app:icon="@drawable/solar_cpu_linear"
        app:key="screenCore"
        app:summary="@string/settings_core_summary"
        app:title="@string/core_settings"
        app:widgetLayout="@layout/preference_widget_chevron" />

    <Preference
        app:fragment="io.nekohasekai.sagernet.ui.settings.DnsSettingsFragment"
        app:icon="@drawable/solar_global_linear"
        app:key="screenDNS"
        app:summary="@string/settings_dns_summary"
        app:title="@string/dns_settings"
        app:widgetLayout="@layout/preference_widget_chevron" />

    <Preference
        app:fragment="io.nekohasekai.sagernet.ui.settings.FragmentSettingsFragment"
        app:icon="@drawable/solar_scissors_square_linear"
        app:key="screenFragment"
        app:summary="@string/settings_fragment_summary"
        app:title="@string/fragment_settings"
        app:widgetLayout="@layout/preference_widget_chevron" />

    <Preference
        app:fragment="io.nekohasekai.sagernet.ui.settings.ObservatorySettingsFragment"
        app:icon="@drawable/solar_chart_2_linear"
        app:key="screenObservatory"
        app:summary="@string/settings_observatory_summary"
        app:title="@string/observatory_settings"
        app:widgetLayout="@layout/preference_widget_chevron" />

    <Preference
        app:fragment="io.nekohasekai.sagernet.ui.settings.AdvancedSettingsFragment"
        app:icon="@drawable/ic_line_wrench_24"
        app:key="screenAdvanced"
        app:summary="@string/settings_advanced_summary"
        app:title="@string/advanced_settings"
        app:widgetLayout="@layout/preference_widget_chevron" />

</PreferenceScreen>
