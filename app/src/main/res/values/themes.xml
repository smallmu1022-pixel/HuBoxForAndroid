    <!-- MD3 Immersive AppBar & Toolbar styles -->
    <!-- AppBarLayout is transparent: the window background (theme-specific) shows through
         to the status bar padding area, eliminating the black-line artifact when using
         colorful preset themes (mint, blue, etc.). Black/White/LightGray themes override
         this below with their own opaque surface color. -->
    <style name="Widget.SagerNet.AppBarLayout" parent="Widget.MaterialComponents.AppBarLayout.Surface">
        <item name="android:background">@android:color/transparent</item>
        <item name="elevation">0dp</item>
    </style>

    <!-- Neutral-theme AppBarLayout overrides: keep opaque surface so transparent window
         background doesn't cause visual bleed on black/white/gray themes. -->
    <style name="Widget.SagerNet.AppBarLayout.Black">
        <item name="android:background">@color/black</item>
    </style>
    <style name="Widget.SagerNet.AppBarLayout.White">
        <item name="android:background">@color/md3_surface</item>
    </style>
    <style name="Widget.SagerNet.AppBarLayout.LightGray">
        <item name="android:background">@color/md3_surface</item>
    </style>

    <style name="Widget.SagerNet.Toolbar" parent="Widget.MaterialComponents.Toolbar.Surface">
        <item name="android:background">@android:color/transparent</item>
        <item name="titleTextColor">?android:attr/textColorPrimary</item>
        <item name="subtitleTextColor">?android:attr/textColorSecondary</item>
        <item name="navigationIconTint">?android:attr/textColorPrimary</item>
        <item name="actionMenuTextColor">?android:attr/textColorPrimary</item>
    </style>

