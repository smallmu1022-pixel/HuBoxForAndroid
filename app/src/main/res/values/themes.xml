        <item name="primaryOrTextSecondary">?colorPrimary</item>
        <item name="primaryOrTextPrimary">?colorPrimary</item>

        <item name="fabColorBackground">?attr/colorSurface</item>
        <item name="selectedColorPrimary">?colorPrimary</item>

        <!-- 沉浸式 Top App Bar 主题与样式 -->
        <item name="actionBarTheme">@style/ThemeOverlay.SagerNet.Toolbar</item>
        <item name="actionBarPopupTheme">@style/ThemeOverlay.SagerNet.Toolbar.Popup</item>
        <item name="appBarLayoutStyle">@style/Widget.SagerNet.AppBarLayout</item>
        <item name="toolbarStyle">@style/Widget.SagerNet.Toolbar</item>
        <item name="actionButtonStyle">@style/Widget.SagerNet.ActionButton</item>
        <item name="actionOverflowButtonStyle">@style/Widget.SagerNet.ActionOverflowButton</item>
        <item name="toolbarNavigationButtonStyle">@style/Widget.SagerNet.ToolbarNavigationButton</item>

        <!-- MD3 Tab 默认样式（高对比、沉浸底色、首字母大写） -->
        <item name="tabStyle">@style/Widget.SagerNet.TabLayout</item>
        <item name="tabTextAppearance">@style/Widget.SagerNet.TabLayout.TextAppearance</item>
        <item name="tabTextColor">?android:attr/textColorSecondary</item>
